---
import type { CollectionEntry } from "astro:content";
import type { DevToArticle } from "@lib/devto";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects"> | DevToArticle;
};

const { entry } = Astro.props;

// Helper to determine if it's a Dev.to article
function isDevTo(item: any): item is DevToArticle {
  return typeof item.id === "number" && typeof item.published_at === "string";
}

// Normalize data
import { formatDate } from "@lib/utils";

// ... (existing code)

let title: string,
  description: string,
  url: string,
  date: Date, // Add date
  tags: string[] = [];
let openInNewTab = false;

if (isDevTo(entry)) {
  title = entry.title;
  description = entry.description;
  url = entry.url;
  tags = entry.tags;
  date = new Date(entry.published_at); // Parse date
  openInNewTab = true;
} else {
  const collectionEntry = entry as
    | CollectionEntry<"blog">
    | CollectionEntry<"projects">;
  title = collectionEntry.data.title;
  description = collectionEntry.data.description;
  date = collectionEntry.data.date; // Get date
  // Type assignment for tags is tricky due to unions, so we cast strictly for now or check existence
  tags = (collectionEntry.data as any).tags || [];

  if (
    "externalUrl" in collectionEntry.data &&
    collectionEntry.data.externalUrl
  ) {
    url = collectionEntry.data.externalUrl;
    openInNewTab = true;
  } else if (
    "demoURL" in collectionEntry.data &&
    collectionEntry.data.demoURL
  ) {
    url = collectionEntry.data.demoURL;
    openInNewTab = true;
  } else if (
    "repoURL" in collectionEntry.data &&
    collectionEntry.data.repoURL
  ) {
    url = collectionEntry.data.repoURL;
    openInNewTab = true;
  } else {
    url = `/${collectionEntry.collection}/${collectionEntry.id}`;
  }
}
---

<a
  href={url}
  target={openInNewTab ? "_blank" : "_self"}
  class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
>
  <div class="flex flex-col flex-1 truncate">
    <div class="text-xs text-black/50 dark:text-white/50 mb-1">
      {formatDate(date)}
    </div>
    <div class="font-semibold">
      {title}
    </div>
    <div class="text-sm line-clamp-2 white-space-normal">
      {description}
    </div>
    {/* Display tags if they exist */}
    {
      Array.isArray(tags) && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          {tags.map((tag: string) => (
            <span class="text-xs rounded px-1 lowercase opacity-75 bg-black/5 dark:bg-white/10">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
    ></polyline>
  </svg>
</a>
