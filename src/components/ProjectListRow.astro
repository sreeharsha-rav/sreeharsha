---
import { type CollectionEntry } from "astro:content";
import SkillBadge from "./SkillBadge.astro";
import { formatDateMonthYear } from "@lib/utils";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<li
    class="animate pb-4 border-b border-black/10 dark:border-white/10 last:border-0"
>
    <div class="flex flex-col gap-2">
        <div class="text-sm text-black/50 dark:text-white/50">
            {formatDateMonthYear(project.data.date)}
        </div>
        <div class="flex items-center justify-between">
            <a
                href={project.data.demoURL ||
                    project.data.repoURL ||
                    `/${project.collection}/${project.id}`}
                target={project.data.demoURL || project.data.repoURL
                    ? "_blank"
                    : "_self"}
                class="font-semibold text-lg hover:underline decoration-black/50 dark:decoration-white/50 underline-offset-4 decoration-2 text-black dark:text-white"
            >
                {project.data.title}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 15 15"
                    fill="none"
                    class="inline-block ml-1 align-baseline"
                >
                    <path
                        d="M3 2C2.44772 2 2 2.44772 2 3V12C2 12.5523 2.44772 13 3 13H12C12.5523 13 13 12.5523 13 12V8.5C13 8.22386 13.2239 8 13.5 8C13.7761 8 14 8.22386 14 8.5V12C14 13.1046 13.1046 14 12 14H3C1.89543 14 1 13.1046 1 12V3C1 1.89543 1.89543 1 3 1H6.5C6.77614 1 7 1.22386 7 1.5C7 1.77614 6.77614 2 6.5 2H3ZM12.8536 2.14645C12.9015 2.19439 12.9377 2.24964 12.9621 2.30861C12.9861 2.36669 12.9996 2.4303 13 2.497V5.5C13 5.77614 12.7761 6 12.5 6C12.2239 6 12 5.77614 12 5.5V3.70711L6.85355 8.85355C6.65829 9.04882 6.34171 9.04882 6.14645 8.85355C5.95118 8.65829 5.95118 8.34171 6.14645 8.14645L11.2929 3H9.5C9.22386 3 9 2.77614 9 2.5C9 2.22386 9.22386 2 9.5 2H12.497C12.5637 2.00036 12.6273 2.01389 12.6853 2.03788C12.7443 2.06231 12.7996 2.09846 12.8536 2.14645Z"
                        fill="currentColor"
                        fill-rule="evenodd"
                        clip-rule="evenodd"></path>
                </svg>
            </a>
        </div>
        <div class="text-sm opacity-75 text-black dark:text-white">
            {project.data.description}
        </div>
        <div class="flex flex-wrap gap-1 mt-1">
            {project.data.skills?.map((skill) => <SkillBadge skill={skill} />)}
        </div>
    </div>
</li>
