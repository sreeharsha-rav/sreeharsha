---
interface Props {
    skill: string;
}

const { skill } = Astro.props;

const SKILL_CONFIG: Record<
    string,
    { logo: string; color: string; label?: string }
> = {
    // Languages
    Java: { logo: "openjdk", color: "ED8B00" },
    TypeScript: { logo: "typescript", color: "3178C6" },
    Python: { logo: "python", color: "3776AB" },
    JavaScript: { logo: "javascript", color: "F7DF1E" },
    C: { logo: "c", color: "A8B9CC" },

    // Frontend
    React: { logo: "react", color: "61DAFB" },
    Vue: { logo: "vuedotjs", color: "4FC08D" },
    HTML: { logo: "html5", color: "E34F26" },
    CSS: { logo: "css", color: "1572B6" },
    Bootstrap: { logo: "bootstrap", color: "7952B3" },
    Nuxt: { logo: "nuxt", color: "00C58E" },
    Vite: { logo: "vite", color: "646CFF" },

    // Backend & Databases
    SQL: { logo: "postgresql", color: "4169E1" },
    PostgreSQL: { logo: "postgresql", color: "4169E1" },
    MySQL: { logo: "mysql", color: "4479A1" },
    MongoDB: { logo: "mongodb", color: "47A248" },
    Redis: { logo: "redis", color: "DC382D" },
    Prisma: { logo: "prisma", color: "2D3748" },
    Sequelize: { logo: "sequelize", color: "52B0E7" },
    Supabase: { logo: "supabase", color: "3ECF8E" },

    // Cloud & DevOps
    AWS: { logo: "amazonwebservices", color: "232F3E" }, // amazons3, amazonaws? generic aws is "amazonwebservices"? SimpleIcons has "amazon".
    Docker: { logo: "docker", color: "2496ED" },
    Kubernetes: { logo: "kubernetes", color: "326CE5" },
    Git: { logo: "git", color: "F05032" },
    GitHub: { logo: "github", color: "181717" },

    // AI & Tools
    LangChain: { logo: "langchain", color: "1C3C3C" },
    Postman: { logo: "postman", color: "FF6C37" },
};

const config =
    SKILL_CONFIG[skill] ||
    SKILL_CONFIG[
        Object.keys(SKILL_CONFIG).find(
            (k) => k.toLowerCase() === skill.toLowerCase(),
        ) || ""
    ] ||
    {};
const label = config.label || skill;
// Fallback for logo if not mapped correctly, generic logic
const logoSlug =
    config.logo ||
    skill.toLowerCase().replace(/\s+/g, "").replace(/\./g, "dot");
// SimpleIcons CDN. Use 'default' color or the specific brand color?
// User wants aesthetic. White text on transparency.
// Icons should probably be white (in dark mode) or colored.
// Let's try colored icon + white text.
// Or just white icon.
const iconUrl = `https://cdn.simpleicons.org/${logoSlug}/${config.color || "gray"}`;
---

<div
    class="flex items-center gap-1.5 px-2 py-1 border rounded-md text-xs font-medium transition-colors duration-300 ease-in-out
            border-black/15 bg-transparent text-black
            dark:border-white/20 dark:text-white"
>
    <img src={iconUrl} alt="" class="w-3.5 h-3.5 object-contain" />
    <span>{label}</span>
</div>
